newton on
package gpu 1 neigh yes split 1.0
suffix gpu

# ---------- Define Temperature List ----------
variable tlist index 200 400 650

# ---------- Temperature Loop ----------
label loop_start
variable T equal ${tlist}
variable seed equal 041125 + ${T}

# ---------- Initialization ----------
units           metal
dimension       3
boundary        p p p
atom_style      atomic

# Reference lattice constant and thermal expansion
variable a0 equal 2.51        
variable c_a equal 1.62   
variable alpha equal 2.3e-5      # Linear thermal expansion coefficient (1/K)

# Temperature-dependent lattice constants
variable a equal ${a0}*(1.0 + ${alpha}*(${T}-300.0))
variable c equal ${a}*${c_a}

print "==============================================================="
print " Running HCP simulation at T = ${T} K"
print "==============================================================="

# ---------- System Setup ----------
# HCP lattice oriented along z (c-axis)
lattice hcp ${a} orient x 1 1 0 orient y -1 1 0 orient z 0 0 1
region box block 0 8 0 8 0 8
create_box 3 box
create_atoms 1 box

mass 1 26.98
mass 2 58.93
mass 3 55.85

# Random substitutional alloy
set type 1 type/fraction 2 0.25 ${seed}
set type 1 type/fraction 3 0.75 041126

# ---------- Interatomic Potential ----------
pair_style      meam
pair_coeff      * * library.meam Al Co Fe AlCoFe.meam Al Co Fe

neighbor        2.0 bin
neigh_modify    delay 10

# ---------- Computations ----------
compute eng all pe/atom
compute eatoms all reduce sum c_eng

thermo          1000
thermo_style    custom step temp press pe etotal c_eatoms lx ly lz
thermo_modify   flush yes

# ---------- Equilibration (NPT ensemble) ----------
velocity all create ${T} ${seed} dist gaussian
fix 1 all npt temp ${T} ${T} 0.1 aniso 0.0 0.0 1.0

dump 1 all cfg 5000 hcp_${T}_*.cfg mass type xs ys zs c_eng
dump_modify 1 element Al Co Fe sort id

run 30000
unfix 1

# ---------- Compute Equilibrium Lattice Constants ----------
# HCP box dimensions: a = lx/(# unit cells along x), c = lz/(# unit cells along z)
variable a_eq equal lx/8
variable c_eq equal lz/8
variable c_a_eq equal ${c_eq}/${a_eq}

# ---------- Output Energy ----------
variable E equal c_eatoms
variable N equal count(all)
variable Ecoh equal ${E}/${N}

print "---------------------------------------------------------------"
print " Equilibrium lattice constants at T=${T} K:"
print " a_eq = ${a_eq} Å"
print " c_eq = ${c_eq} Å"
print " c/a ratio = ${c_a_eq}"
print " Cohesive Energy (eV/atom) = ${Ecoh}"
print " Structure: HCP"
print "---------------------------------------------------------------"

# Write equilibrated data file
write_data hcp_${T}.data

# ---------- Cleanup and Loop ----------
clear
next tlist
jump SELF loop_start
