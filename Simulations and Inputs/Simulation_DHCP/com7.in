newton on
package gpu 1 neigh yes split 1.0
suffix gpu

# ---------- Define Temperature List ----------
variable tlist index 200 400 650

# ---------- Temperature Loop ----------
label loop_start
variable T equal ${tlist}
variable seed equal 041125+v_T

# ---------- Initialization ----------
units           metal
dimension       3
boundary        p p p
atom_style      atomic

# ---------- Reference Parameters ----------
variable a0 equal 2.42
variable c_a equal 6.38           # Double of HCP c/a (~3.19 × 2)
variable alpha equal 13.3e-6      # Linear thermal expansion coefficient (1/K)

# ---------- Temperature-Dependent Lattice Constants ----------
variable a equal "v_a0*(1.0+v_alpha*(v_T-300.0))"
variable c equal "v_a*v_c_a"

print "=================================================================="
print " Running DHCP simulation at T = ${T} K"
print "=================================================================="

# ---------- System Setup ----------
# Orientation keeps basal plane (0001) in xy-plane; c-axis along z
lattice hcp ${a} orient x 1 1 0 orient y -1 1 0 orient z 0 0 1

# Make box integer multiples of lattice (avoids needle-like shape)
region box block 0 8 0 8 0 10 units lattice
create_box 3 box
create_atoms 1 box

# ---------- Mass and Alloy Definition ----------
mass 1 26.98
mass 2 58.93
mass 3 55.85

# Random substitutional alloy
set type 1 type/fraction 2 0.5 ${seed}
set type 1 type/fraction 3 0.5 041126

# ---------- Interatomic Potential ----------
pair_style      meam                      # Cutoff radius = 5 Å
pair_coeff      * * library.meam Al Co Fe AlCoFe.meam Al Co Fe

neighbor        2.0 bin
neigh_modify    delay 10

# ---------- Relaxation (Energy Minimization) ----------
min_style cg
minimize 1e-10 1e-10 10000 10000

# ---------- Computations ----------
compute eng all pe/atom
compute eatoms all reduce sum c_eng

thermo          1000
thermo_style    custom step temp press pe etotal c_eatoms lx ly lz
thermo_modify   flush yes

# ---------- Equilibration (NPT ensemble) ----------
velocity all create ${T} ${seed} dist gaussian
fix 1 all npt temp ${T} ${T} 0.1 aniso 0.0 0.0 1.0

dump 1 all cfg 5000 dhcp_${T}_*.cfg mass type xs ys zs c_eng
dump_modify 1 element Al Co Fe sort id

run 30000
unfix 1

# ---------- Compute Equilibrium Lattice Constants ----------
# a = lx/(8*1.73); c = lz/10 for DHCP
variable a_eq equal lx/(8.0*1.73)
variable c_eq equal lz/10.0
variable c_a_eq equal ${c_eq}/${a_eq}

# ---------- Output Energy ----------
variable E equal c_eatoms
variable N equal count(all)
variable Ecoh equal ${E}/${N}

print "------------------------------------------------------------------"
print " Equilibrium lattice constants at T=${T} K:"
print " a_eq = ${a_eq} Å"
print " c_eq = ${c_eq} Å"
print " c/a ratio = ${c_a_eq}"
print " Cohesive Energy (eV/atom) = ${Ecoh}"
print " Structure: DHCP"
print "------------------------------------------------------------------"

# Write equilibrated data file
write_data dhcp_${T}.data